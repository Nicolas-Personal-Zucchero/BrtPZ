# Copy this file to '.env' and insert your BRT credentials.
# The '.env' file is ignored by git and will not be committed.
BRT_USER_ID=your_user_id_here
BRT_SECURITY_TOKEN=your_security_token_or_password_here
BRT_CUSTOMER_CODE=your_customer_code_here
BRT_DEPARTURE_DEPOT=your_departure_depot_here
BRT_SANDBOX=true
